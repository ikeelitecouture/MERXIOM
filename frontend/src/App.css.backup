@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #111;
  background: #f7f7f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #f7f7f5;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.app {
  min-height: 100vh;
  overflow-x: hidden;
}

.eyebrow {
  margin: 0 0 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #777;
}

/* NAVBAR */

.navbar {
  position: sticky;
  top: 0;
  z-index: 50;

  height: 68px;
  padding: 0 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(247, 247, 245, 0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-bottom: 1px solid #e5e5e2;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;

  font-family: "Space Grotesk", sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.brand-mark {
  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  background: #111;
  color: white;

  border-radius: 9px;

  font-size: 16px;
}

.nav-links {
  display: none;
}

.cart-button {
  position: relative;

  padding: 9px 14px;

  border: 1px solid #dededb;
  border-radius: 999px;

  background: white;

  font-size: 12px;
  font-weight: 600;
}

.cart-count {
  position: absolute;
  top: -6px;
  right: -5px;

  min-width: 18px;
  height: 18px;

  display: grid;
  place-items: center;

  background: #111;
  color: white;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 700;
}

/* HERO */

.hero {
  width: min(1180px, calc(100% - 32px));
  margin: 16px auto 0;

  display: grid;
  gap: 18px;
}

.hero-content {
  padding: 28px 4px 5px;
}

.hero h1 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: clamp(43px, 11vw, 76px);
  line-height: 0.95;
  letter-spacing: -0.065em;
}

.hero h1 span {
  color: #8a8a85;
}

.hero-text {
  max-width: 470px;

  margin: 20px 0 0;

  color: #696965;

  font-size: 14px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;

  margin-top: 23px;
}

.primary-button,
.secondary-button {
  min-height: 44px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 18px;

  border-radius: 999px;

  font-size: 12px;
  font-weight: 700;
}

.primary-button {
  background: #111;
  color: white;
}

.secondary-button {
  background: white;
  color: #222;
  border: 1px solid #dededb;
}

/* FEATURED PRODUCT */

.hero-card {
  position: relative;

  min-height: 470px;

  overflow: hidden;

  background: #e9e7e2;

  border: 1px solid #dfddd8;
  border-radius: 26px;
}

.hero-card-top {
  position: absolute;
  top: 18px;
  left: 18px;
  right: 18px;

  z-index: 3;

  display: flex;
  justify-content: space-between;

  color: #555;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.hero-card > img {
  width: 100%;
  height: 390px;

  display: block;

  object-fit: cover;

  mix-blend-mode: multiply;

  transform: scale(1.02);
}

.hero-product-info {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;

  z-index: 4;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  padding: 15px 16px;

  background: rgba(255, 255, 255, 0.9);

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);

  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 17px;
}

.hero-product-info small {
  display: block;

  margin-bottom: 5px;

  color: #777;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hero-product-info h3 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 15px;
  letter-spacing: -0.03em;
}

.hero-product-info strong {
  white-space: nowrap;

  font-family: "Space Grotesk", sans-serif;
  font-size: 16px;
}

/* SECTIONS */

.category-section,
.products-section {
  width: min(1180px, calc(100% - 32px));
  margin: 58px auto 0;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 28px;
  line-height: 1;
  letter-spacing: -0.055em;
}

/* CATEGORIES */

.categories {
  display: flex;
  gap: 9px;

  overflow-x: auto;

  padding-bottom: 5px;

  scrollbar-width: none;
}

.categories::-webkit-scrollbar {
  display: none;
}

.categories button {
  flex: 0 0 auto;

  padding: 11px 15px;

  border: 1px solid #dfdfdc;
  border-radius: 999px;

  background: white;
  color: #333;

  font-size: 11px;
  font-weight: 600;
}

.categories button:first-child {
  background: #111;
  color: white;
  border-color: #111;
}

/* SEARCH */

.search-box {
  display: none;
}

.search-box input {
  width: 220px;

  padding: 11px 14px;

  border: 1px solid #dfdfdc;
  border-radius: 999px;

  outline: none;

  background: white;

  font-size: 12px;
}

.search-box input:focus {
  border-color: #111;
}

/* PRODUCTS */

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.product-card {
  min-width: 0;
}

.product-image {
  position: relative;

  height: 220px;

  overflow: hidden;

  background: #ecebe7;

  border-radius: 17px;
}

.product-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  mix-blend-mode: multiply;

  transition: transform 0.35s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.04);
}

.product-category {
  position: absolute;
  top: 10px;
  left: 10px;

  z-index: 2;

  padding: 6px 8px;

  background: rgba(255, 255, 255, 0.88);

  backdrop-filter: blur(8px);

  border-radius: 999px;

  font-size: 8px;
  font-weight: 700;
}

.quick-add {
  position: absolute;
  right: 10px;
  bottom: 10px;

  z-index: 3;

  width: 35px;
  height: 35px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;

  background: #111;
  color: white;

  font-size: 20px;

  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
}

.product-details {
  padding: 9px 2px 0;
}

.product-details > p {
  margin: 0 0 4px;

  overflow: hidden;

  color: #8a8a86;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.08em;

  text-transform: uppercase;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-details h3 {
  margin: 0;

  overflow: hidden;

  font-family: "Space Grotesk", sans-serif;
  font-size: 13px;
  line-height: 1.2;
  letter-spacing: -0.025em;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  margin-top: 8px;
}

.product-bottom strong {
  font-family: "Space Grotesk", sans-serif;
  font-size: 13px;
}

.product-bottom button {
  padding: 7px 10px;

  border: 0;
  border-radius: 999px;

  background: #111;
  color: white;

  font-size: 8px;
  font-weight: 700;

  white-space: nowrap;
}

/* STATES */

.loading-text,
.empty-state {
  padding: 35px 0;

  color: #777;

  text-align: center;

  font-size: 13px;
}

.empty-state h3 {
  margin: 0 0 5px;

  color: #111;

  font-family: "Space Grotesk", sans-serif;
}

/* BUSINESS */

.business-banner {
  width: min(1180px, calc(100% - 32px));

  margin: 75px auto 0;

  padding: 30px 22px;

  display: flex;
  flex-direction: column;
  gap: 22px;

  background: #111;
  color: white;

  border-radius: 24px;
}

.business-banner .eyebrow {
  color: #888;
}

.business-banner h2 {
  max-width: 600px;

  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: clamp(29px, 8vw, 50px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.business-banner p:not(.eyebrow) {
  max-width: 500px;

  margin: 13px 0 0;

  color: #aaa;

  font-size: 13px;
  line-height: 1.6;
}

.business-banner button {
  align-self: flex-start;

  padding: 12px 17px;

  border: 0;
  border-radius: 999px;

  background: white;
  color: #111;

  font-size: 11px;
  font-weight: 700;
}

/* DISCOVER */

.discover-section {
  width: min(1180px, calc(100% - 32px));

  margin: 18px auto 0;

  padding: 30px 22px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  background: #e9e7e2;

  border-radius: 24px;
}

.discover-section h2 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 30px;
  letter-spacing: -0.055em;
}

.discover-section p:not(.eyebrow) {
  max-width: 500px;

  margin: 12px 0 0;

  color: #686863;

  font-size: 13px;
  line-height: 1.6;
}

.discover-section > span {
  flex: 0 0 auto;

  padding: 7px 9px;

  background: #111;
  color: white;

  border-radius: 999px;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.1em;
}

/* FOOTER */

footer {
  width: min(1180px, calc(100% - 32px));

  margin: 55px auto 0;

  padding: 25px 0 35px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid #dededb;
}

footer .brand {
  font-size: 15px;
}

footer .brand-mark {
  width: 25px;
  height: 25px;
  font-size: 13px;
}

footer p {
  margin: 0;

  color: #888;

  font-size: 10px;
}

/* TABLET */

@media (min-width: 700px) {
  .navbar {
    padding: 0 35px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .nav-links a {
    color: #555;

    font-size: 11px;
    font-weight: 600;
  }

  .hero {
    margin-top: 28px;

    grid-template-columns: 0.85fr 1.15fr;

    align-items: stretch;
  }

  .hero-content {
    padding: 55px 15px 40px 0;
  }

  .hero-card {
    min-height: 560px;
  }

  .hero-card > img {
    height: 470px;
  }

  .product-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 17px;
  }

  .product-image {
    height: 270px;
  }

  .business-banner {
    flex-direction: row;

    align-items: flex-end;
    justify-content: space-between;

    padding: 45px;
  }
}

/* DESKTOP */

@media (min-width: 1000px) {
  .navbar {
    height: 74px;
    padding: 0 55px;
  }

  .brand {
    font-size: 20px;
  }

  .hero {
    width: min(1250px, calc(100% - 80px));

    grid-template-columns: 0.9fr 1.1fr;

    gap: 30px;
  }

  .hero-content {
    padding-top: 85px;
  }

  .hero h1 {
    font-size: 82px;
  }

  .hero-card {
    min-height: 610px;

    border-radius: 32px;
  }

  .hero-card > img {
    height: 520px;
  }

  .category-section,
  .products-section,
  .business-banner,
  .discover-section,
  footer {
    width: min(1250px, calc(100% - 80px));
  }

  .category-section,
  .products-section {
    margin-top: 85px;
  }

  .section-heading h2 {
    font-size: 34px;
  }

  .search-box {
    display: block;
  }

  .product-image {
    height: 320px;

    border-radius: 20px;
  }

  .product-details {
    padding-top: 13px;
  }

  .product-details h3 {
    font-size: 15px;
  }

  .product-bottom strong {
    font-size: 15px;
  }

  .product-bottom button {
    padding: 8px 12px;
    font-size: 9px;
  }

  .business-banner {
    margin-top: 110px;
  }

  .discover-section {
    padding: 45px;
  }
}
