/* MERXIOM AI: responsive conversation drawer */
.ai-sidebar-backdrop { display: none; }
.ai-mobile-menu { display: none; }

@media (max-width: 760px) {
  .ai-page {
    position: relative;
    overflow: hidden;
  }

  .ai-page .ai-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(84vw, 320px);
    max-width: calc(100vw - 48px);
    height: 100dvh;
    z-index: 1200;
    display: flex;
    flex-direction: column;
    transform: translateX(-105%);
    visibility: hidden;
    transition: transform 240ms ease, visibility 240ms ease;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 12px 0 36px rgba(0, 0, 0, .22);
    padding: 13px;
    background: #f6f8fb;
  }

  .ai-page .ai-sidebar.mobile-open {
    transform: translateX(0);
    visibility: visible;
  }

  .ai-page .ai-sidebar.collapsed {
    width: min(84vw, 320px);
    padding: 13px;
  }

  .ai-page .ai-sidebar .ai-mini-brand b,
  .ai-page .ai-sidebar .ai-history-label,
  .ai-page .ai-sidebar .ai-history button span {
    display: initial;
  }

  .ai-page .ai-sidebar .ai-new-chat {
    justify-content: flex-start;
    padding: 11px;
    font-size: 11px;
  }

  .ai-page .ai-sidebar .ai-history button {
    padding: 10px;
  }

  .ai-page .ai-sidebar .ai-side-bottom a {
    justify-content: flex-start;
    font-size: 10px;
    padding: 9px;
  }

  .ai-sidebar-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1100;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    background: rgba(10, 16, 28, .48);
  }

  .ai-mobile-menu {
    display: inline-flex;
    flex-shrink: 0;
  }

  .ai-page .ai-chat {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .ai-page .ai-chat-top {
    gap: 8px;
    padding: 0 12px;
  }

  .ai-page .ai-chat-top > div {
    min-width: 0;
    margin-right: auto;
  }

  .ai-page .ai-chat-top .btn {
    flex-shrink: 0;
  }

  .ai-page .ai-messages {
    min-width: 0;
  }

  .ai-page .ai-composer {
    max-width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ai-page .ai-sidebar {
    transition: none;
  }
}


/* Private MERXIOM AI memory controls */
.ai-top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.ai-top-actions button:disabled{opacity:.5;cursor:not-allowed}
.ai-memory-panel{width:min(100%,920px);margin:0 auto 14px;padding:18px;border:1px solid var(--line,#e2e8f0);border-radius:16px;background:var(--surface,#fff);box-shadow:0 8px 24px rgba(15,23,42,.06)}
.ai-memory-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.ai-memory-heading p{margin:5px 0 12px;color:var(--muted,#64748b);font-size:13px;line-height:1.5}
.ai-memory-form{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,220px);gap:9px}
.ai-memory-form input,.ai-memory-form select,.ai-memory-form textarea{width:100%;min-width:0;border:1px solid var(--line,#cbd5e1);border-radius:10px;padding:11px 12px;background:var(--surface,#fff);color:inherit;font:inherit}
.ai-memory-form textarea{grid-column:1/-1;resize:vertical}
.ai-memory-form button{justify-self:start}
.ai-memory-status{font-size:13px;color:var(--muted,#64748b);margin:10px 0}
.ai-memory-list{display:grid;gap:8px;margin-top:12px}
.ai-memory-list>article{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;border-top:1px solid var(--line,#e2e8f0);padding:12px 0}
.ai-memory-list>article p{margin:5px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}
.ai-memory-list>article small{display:block;margin-top:3px;color:var(--muted,#64748b);font-size:11px}
.ai-memory-list>p{color:var(--muted,#64748b);font-size:13px}
@media(max-width:600px){.ai-memory-form{grid-template-columns:1fr}.ai-memory-form textarea{grid-column:auto}.ai-memory-panel{padding:13px}.ai-top-actions .btn{padding:7px 9px}}

.shipment-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px;padding-top:10px;border-top:1px solid var(--line,#e2e8f0);font-size:12px;color:var(--muted,#64748b);text-transform:capitalize}
.shipment-meta b{color:var(--text,#0f172a)}
@media(max-width:560px){.shipment-meta{align-items:flex-start;flex-direction:column}}
