import { useEffect, useState } from "react";
import "./App.css";
import BusinessDashboard from "./pages/BusinessDashboard";
import AuthPage from "./pages/AuthPage";

const API = "http://localhost:5000/api";

const localProducts = [
  {
    id: "sneaker-1",
    name: "Urban Classic Sneaker",
    price: 34999,
    category: "Sneakers",
    image: "/products/sneakers-1.png",
    store: "AXIOM Test Store",
  },
  {
    id: "sneaker-2",
    name: "Street Flex Sneaker",
    price: 28500,
    category: "Sneakers",
    image: "/products/sneakers-2.png",
    store: "AXIOM Test Store",
  },
  {
    id: "sneaker-3",
    name: "Everyday Runner",
    price: 17998,
    category: "Sneakers",
    image: "/products/sneakers-3.png",
    store: "AXIOM Test Store",
  },
  {
    id: "sneaker-4",
    name: "Essential Casual Sneaker",
    price: 7199,
    category: "Sneakers",
    image: "/products/sneakers-4.png",
    store: "AXIOM Test Store",
  },
];

function formatPrice(price) {
  return new Intl.NumberFormat("en-NG", {
    style: "currency",
    currency: "NGN",
    maximumFractionDigits: 0,
  }).format(price);
}

function ProductDetails({ productId }) {
  const [product, setProduct] = useState(null);
  const [selectedImage, setSelectedImage] = useState(0);
  const [quantity, setQuantity] = useState(1);
  const [loading, setLoading] = useState(true);
  const [message, setMessage] = useState("");

  useEffect(() => {
    const loadProduct = async () => {
      try {
        const response = await fetch(`${API}/products`);
        const data = await response.json();

        if (!data.success) {
          throw new Error(data.message || "Unable to load product.");
        }

        const found = data.products.find(
          (item) => item._id === productId
        );

        if (!found) {
          throw new Error("Product not found.");
        }

        setProduct({
          ...found,
          imageUrls: (found.images || []).map(
            (image) => `${API.replace("/api", "")}${image}`
          ),
        });
      } catch (error) {
        console.error(error);
        setMessage(error.message || "Unable to load product.");
      } finally {
        setLoading(false);
      }
    };

    loadProduct();
  }, [productId]);

  if (loading) {
    return (
      <div className="product-page-state">
        <p>Loading product...</p>
      </div>
    );
  }

  if (!product) {
    return (
      <div className="product-page-state">
        <h2>Product not found</h2>
        <p>{message}</p>
        <button
          className="primary-button"
          onClick={() => (window.location.href = "/")}
        >
          Back to marketplace
        </button>
      </div>
    );
  }

  const images = product.imageUrls || [];
  const stock = Number(product.stock || 0);
  const hasStock = stock > 0;

  const increaseQuantity = () => {
    setQuantity((current) =>
      hasStock ? Math.min(current + 1, stock) : current
    );
  };

  const decreaseQuantity = () => {
    setQuantity((current) => Math.max(1, current - 1));
  };

  const addProductToCart = () => {
    if (!hasStock) return;

    setMessage(
      `${quantity} × ${product.name} added to cart.`
    );
  };

  return (
    <div className="product-page">
      <nav className="navbar">
        <button
          className="product-back-button"
          onClick={() => (window.location.href = "/")}
        >
          ← Back
        </button>

        <div className="brand">
          <span className="brand-mark">A</span>
          <span>AXIOM</span>
        </div>

        <div className="nav-actions">
          <a href="/business" className="nav-login">
            Business
          </a>
          <button className="cart-button">
            🛒 Cart
          </button>
        </div>
      </nav>

      <main className="product-detail-main">
        <div className="product-detail-grid">
          <section className="product-gallery">
            <div className="product-main-image">
              {images.length > 0 ? (
                <img
                  src={images[selectedImage]}
                  alt={product.name}
                />
              ) : (
                <div className="product-detail-no-image">
                  <span>AXIOM</span>
                  <small>No image available</small>
                </div>
              )}
            </div>

            {images.length > 1 && (
              <div className="product-thumbnails">
                {images.map((image, index) => (
                  <button
                    key={`${image}-${index}`}
                    className={
                      selectedImage === index
                        ? "product-thumbnail active"
                        : "product-thumbnail"
                    }
                    onClick={() => setSelectedImage(index)}
                  >
                    <img
                      src={image}
                      alt={`${product.name} ${index + 1}`}
                    />
                  </button>
                ))}
              </div>
            )}
          </section>

          <section className="product-detail-info">
            <p className="product-detail-category">
              {product.category}
            </p>

            <h1>{product.name}</h1>

            <p className="product-detail-store">
              Sold by <strong>{product.business?.name || "AXIOM Store"}</strong>
            </p>

            <div className="product-detail-price">
              {formatPrice(product.price)}
            </div>

            <div
              className={
                hasStock
                  ? "product-stock in-stock"
                  : "product-stock out-stock"
              }
            >
              <span />
              {hasStock
                ? `${stock} available`
                : "Currently out of stock"}
            </div>

            {product.description && (
              <div className="product-description">
                <h3>Description</h3>
                <p>{product.description}</p>
              </div>
            )}

            {hasStock && (
              <div className="product-purchase">
                <div className="quantity-control">
                  <button
                    type="button"
                    onClick={decreaseQuantity}
                    disabled={quantity <= 1}
                  >
                    −
                  </button>

                  <strong>{quantity}</strong>

                  <button
                    type="button"
                    onClick={increaseQuantity}
                    disabled={quantity >= stock}
                  >
                    +
                  </button>
                </div>

                <button
                  className="product-add-cart"
                  onClick={addProductToCart}
                >
                  Add to cart
                </button>
              </div>
            )}

            {message && (
              <div className="product-detail-message">
                {message}
              </div>
            )}
          </section>
        </div>
      </main>
    </div>
  );
}

function Market() {
  const [products, setProducts] = useState(localProducts);
  const [cartCount, setCartCount] = useState(0);
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loadProducts = async () => {
      try {
        const response = await fetch(`${API}/products`);
        const data = await response.json();

        if (data.success && data.products?.length) {
          const backendProducts = data.products.map((product, index) => ({
            id: product._id,
            name: product.name,
            price: product.price,
            category: product.category,
            image: product.images?.[0]
              ? `${API.replace("/api", "")}${product.images[0]}`
              : "",
            store: product.business?.name || "AXIOM Store",
          }));

          setProducts(backendProducts);
        }
      } catch (error) {
        console.log("Using local product showcase:", error.message);
      } finally {
        setLoading(false);
      }
    };

    loadProducts();
  }, []);

  const filteredProducts = products.filter((product) =>
    `${product.name} ${product.category} ${product.store}`
      .toLowerCase()
      .includes(search.toLowerCase())
  );

  const addToCart = () => {
    setCartCount((count) => count + 1);
  };

  return (
    <div className="app">
      <nav className="navbar">
        <div className="brand">
          <span className="brand-mark">A</span>
          <span>AXIOM</span>
        </div>

        <div className="nav-links">
          <a href="#shop">Shop</a>
          <a href="#categories">Categories</a>
          <a href="#discover">Discover</a>
          <a href="/business">Business</a>
        </div>

        <div className="nav-actions">
          <a href="/login" className="nav-login">Sign in</a>
          <a href="/register" className="nav-sell">Sell on AXIOM</a>

          <button className="cart-button">
            🛒 Cart
            {cartCount > 0 && <span className="cart-count">{cartCount}</span>}
          </button>
        </div>
      </nav>

      <main>
        <section className="hero">
          <div className="hero-content">
            <p className="eyebrow">THE NEW WAY TO SHOP</p>

            <h1>
              Discover what
              <br />
              <span>you'll love.</span>
            </h1>

            <p className="hero-text">
              Discover products from businesses and sellers across Nigeria.
              Shop smarter. Find better. Buy with AXIOM.
            </p>

            <div className="hero-actions">
              <a href="#shop" className="primary-button">
                Start shopping
              </a>

              <a href="/business" className="secondary-button">
                Sell on AXIOM →
              </a>
            </div>
          </div>

          <div className="hero-card">
            <div className="hero-card-top">
              <span>FEATURED</span>
              <span>01 / 04</span>
            </div>

            <img
              src="/products/sneakers-1.png"
              alt="Featured sneaker"
            />

            <div className="hero-product-info">
              <div>
                <small>AXIOM TEST STORE</small>
                <h3>Urban Classic Sneaker</h3>
              </div>

              <strong>₦34,999</strong>
            </div>
          </div>
        </section>

        <section className="category-section" id="categories">
          <div className="section-heading">
            <div>
              <p className="eyebrow">EXPLORE</p>
              <h2>Shop by category</h2>
            </div>
          </div>

          <div className="categories">
            <button>👟 Sneakers</button>
            <button>👕 Fashion</button>
            <button>👜 Bags</button>
            <button>💄 Beauty</button>
            <button>📱 Gadgets</button>
            <button>🏠 Home</button>
          </div>
        </section>

        <section className="products-section" id="shop">
          <div className="section-heading">
            <div>
              <p className="eyebrow">MARKETPLACE</p>
              <h2>Trending products</h2>
            </div>

            <div className="search-box">
              <input
                type="text"
                placeholder="Search products..."
                value={search}
                onChange={(event) => setSearch(event.target.value)}
              />
            </div>
          </div>

          {loading && (
            <p className="loading-text">Loading marketplace...</p>
          )}

          <div className="product-grid">
            {filteredProducts.map((product) => (
              <article
                className="product-card"
                key={product.id}
                onClick={() => {
                  if (product.id && !String(product.id).startsWith("sneaker-")) {
                    window.location.href = `/product/${product.id}`;
                  }
                }}
                role={
                  !String(product.id).startsWith("sneaker-")
                    ? "button"
                    : undefined
                }
                tabIndex={
                  !String(product.id).startsWith("sneaker-")
                    ? 0
                    : undefined
                }
              >
                <div className="product-image">
                  <span className="product-category">
                    {product.category}
                  </span>

                  <button
                    className="quick-add"
                    onClick={(event) => {
                      event.stopPropagation();
                      addToCart();
                    }}
                    aria-label={`Add ${product.name} to cart`}
                  >
                    +
                  </button>

                  {product.image ? (
                    <img src={product.image} alt={product.name} />
                  ) : (
                    <div className="product-no-image">
                      <span>AXIOM</span>
                      <small>No image available</small>
                    </div>
                  )}
                </div>

                <div className="product-details">
                  <p>{product.store}</p>

                  <h3>{product.name}</h3>

                  <div className="product-bottom">
                    <strong>{formatPrice(product.price)}</strong>

                    <button
                      onClick={(event) => {
                        event.stopPropagation();
                        addToCart();
                      }}
                    >
                      Add to cart
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          {!loading && filteredProducts.length === 0 && (
            <div className="empty-state">
              <h3>No products found</h3>
              <p>Try another search.</p>
            </div>
          )}
        </section>

        <section className="business-banner" id="business">
          <div>
            <p className="eyebrow">FOR BUSINESSES</p>
            <h2>Turn your business into an online store.</h2>
            <p>
              Create your AXIOM store, add products and start reaching
              customers online.
            </p>
          </div>

          <a href="/business" className="dashboard-primary">
            Create a store →
          </a>
        </section>

        <section className="discover-section" id="discover">
          <div>
            <p className="eyebrow">COMING NEXT</p>
            <h2>AXIOM Discover</h2>
            <p>
              A social shopping experience where products become content
              and discovery becomes part of shopping.
            </p>
          </div>

          <span>SOON</span>
        </section>
      </main>

      <footer>
        <div className="brand">
          <span className="brand-mark">A</span>
          <span>AXIOM</span>
        </div>

        <p>Discover. Shop. Grow.</p>
      </footer>
    </div>
  );
}

function App() {
  const path = window.location.pathname;

  const productMatch = path.match(/^\/product\/([^/]+)$/);

  if (productMatch) {
    return <ProductDetails productId={productMatch[1]} />;
  }

  if (path === "/business") {
    return <BusinessDashboard />;
  }

  if (path === "/login" || path === "/register") {
    return <AuthPage />;
  }

  return <Market />;
}

export default App;
