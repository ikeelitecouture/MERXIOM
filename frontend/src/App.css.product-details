@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #111;
  background: #f7f7f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #f7f7f5;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.app {
  min-height: 100vh;
  overflow-x: hidden;
}

.eyebrow {
  margin: 0 0 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #777;
}

/* NAVBAR */

.navbar {
  position: sticky;
  top: 0;
  z-index: 50;

  height: 68px;
  padding: 0 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(247, 247, 245, 0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-bottom: 1px solid #e5e5e2;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;

  font-family: "Space Grotesk", sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.brand-mark {
  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  background: #111;
  color: white;

  border-radius: 9px;

  font-size: 16px;
}

.nav-links {
  display: none;
}

.cart-button {
  position: relative;

  padding: 9px 14px;

  border: 1px solid #dededb;
  border-radius: 999px;

  background: white;

  font-size: 12px;
  font-weight: 600;
}

.cart-count {
  position: absolute;
  top: -6px;
  right: -5px;

  min-width: 18px;
  height: 18px;

  display: grid;
  place-items: center;

  background: #111;
  color: white;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 700;
}

/* HERO */

.hero {
  width: min(1180px, calc(100% - 32px));
  margin: 16px auto 0;

  display: grid;
  gap: 18px;
}

.hero-content {
  padding: 28px 4px 5px;
}

.hero h1 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: clamp(43px, 11vw, 76px);
  line-height: 0.95;
  letter-spacing: -0.065em;
}

.hero h1 span {
  color: #8a8a85;
}

.hero-text {
  max-width: 470px;

  margin: 20px 0 0;

  color: #696965;

  font-size: 14px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;

  margin-top: 23px;
}

.primary-button,
.secondary-button {
  min-height: 44px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 18px;

  border-radius: 999px;

  font-size: 12px;
  font-weight: 700;
}

.primary-button {
  background: #111;
  color: white;
}

.secondary-button {
  background: white;
  color: #222;
  border: 1px solid #dededb;
}

/* FEATURED PRODUCT */

.hero-card {
  position: relative;

  min-height: 470px;

  overflow: hidden;

  background: #e9e7e2;

  border: 1px solid #dfddd8;
  border-radius: 26px;
}

.hero-card-top {
  position: absolute;
  top: 18px;
  left: 18px;
  right: 18px;

  z-index: 3;

  display: flex;
  justify-content: space-between;

  color: #555;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.hero-card > img {
  width: 100%;
  height: 390px;

  display: block;

  object-fit: cover;

  mix-blend-mode: multiply;

  transform: scale(1.02);
}

.hero-product-info {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;

  z-index: 4;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  padding: 15px 16px;

  background: rgba(255, 255, 255, 0.9);

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);

  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 17px;
}

.hero-product-info small {
  display: block;

  margin-bottom: 5px;

  color: #777;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hero-product-info h3 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 15px;
  letter-spacing: -0.03em;
}

.hero-product-info strong {
  white-space: nowrap;

  font-family: "Space Grotesk", sans-serif;
  font-size: 16px;
}

/* SECTIONS */

.category-section,
.products-section {
  width: min(1180px, calc(100% - 32px));
  margin: 58px auto 0;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 28px;
  line-height: 1;
  letter-spacing: -0.055em;
}

/* CATEGORIES */

.categories {
  display: flex;
  gap: 9px;

  overflow-x: auto;

  padding-bottom: 5px;

  scrollbar-width: none;
}

.categories::-webkit-scrollbar {
  display: none;
}

.categories button {
  flex: 0 0 auto;

  padding: 11px 15px;

  border: 1px solid #dfdfdc;
  border-radius: 999px;

  background: white;
  color: #333;

  font-size: 11px;
  font-weight: 600;
}

.categories button:first-child {
  background: #111;
  color: white;
  border-color: #111;
}

/* SEARCH */

.search-box {
  display: none;
}

.search-box input {
  width: 220px;

  padding: 11px 14px;

  border: 1px solid #dfdfdc;
  border-radius: 999px;

  outline: none;

  background: white;

  font-size: 12px;
}

.search-box input:focus {
  border-color: #111;
}

/* PRODUCTS */

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.product-card {
  min-width: 0;
}

.product-image {
  position: relative;

  height: 220px;

  overflow: hidden;

  background: #ecebe7;

  border-radius: 17px;
}

.product-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  mix-blend-mode: multiply;

  transition: transform 0.35s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.04);
}

.product-category {
  position: absolute;
  top: 10px;
  left: 10px;

  z-index: 2;

  padding: 6px 8px;

  background: rgba(255, 255, 255, 0.88);

  backdrop-filter: blur(8px);

  border-radius: 999px;

  font-size: 8px;
  font-weight: 700;
}

.quick-add {
  position: absolute;
  right: 10px;
  bottom: 10px;

  z-index: 3;

  width: 35px;
  height: 35px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;

  background: #111;
  color: white;

  font-size: 20px;

  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
}

.product-details {
  padding: 9px 2px 0;
}

.product-details > p {
  margin: 0 0 4px;

  overflow: hidden;

  color: #8a8a86;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.08em;

  text-transform: uppercase;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-details h3 {
  margin: 0;

  overflow: hidden;

  font-family: "Space Grotesk", sans-serif;
  font-size: 13px;
  line-height: 1.2;
  letter-spacing: -0.025em;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  margin-top: 8px;
}

.product-bottom strong {
  font-family: "Space Grotesk", sans-serif;
  font-size: 13px;
}

.product-bottom button {
  padding: 7px 10px;

  border: 0;
  border-radius: 999px;

  background: #111;
  color: white;

  font-size: 8px;
  font-weight: 700;

  white-space: nowrap;
}

/* STATES */

.loading-text,
.empty-state {
  padding: 35px 0;

  color: #777;

  text-align: center;

  font-size: 13px;
}

.empty-state h3 {
  margin: 0 0 5px;

  color: #111;

  font-family: "Space Grotesk", sans-serif;
}

/* BUSINESS */

.business-banner {
  width: min(1180px, calc(100% - 32px));

  margin: 75px auto 0;

  padding: 30px 22px;

  display: flex;
  flex-direction: column;
  gap: 22px;

  background: #111;
  color: white;

  border-radius: 24px;
}

.business-banner .eyebrow {
  color: #888;
}

.business-banner h2 {
  max-width: 600px;

  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: clamp(29px, 8vw, 50px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.business-banner p:not(.eyebrow) {
  max-width: 500px;

  margin: 13px 0 0;

  color: #aaa;

  font-size: 13px;
  line-height: 1.6;
}

.business-banner button {
  align-self: flex-start;

  padding: 12px 17px;

  border: 0;
  border-radius: 999px;

  background: white;
  color: #111;

  font-size: 11px;
  font-weight: 700;
}

/* DISCOVER */

.discover-section {
  width: min(1180px, calc(100% - 32px));

  margin: 18px auto 0;

  padding: 30px 22px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  background: #e9e7e2;

  border-radius: 24px;
}

.discover-section h2 {
  margin: 0;

  font-family: "Space Grotesk", sans-serif;
  font-size: 30px;
  letter-spacing: -0.055em;
}

.discover-section p:not(.eyebrow) {
  max-width: 500px;

  margin: 12px 0 0;

  color: #686863;

  font-size: 13px;
  line-height: 1.6;
}

.discover-section > span {
  flex: 0 0 auto;

  padding: 7px 9px;

  background: #111;
  color: white;

  border-radius: 999px;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.1em;
}

/* FOOTER */

footer {
  width: min(1180px, calc(100% - 32px));

  margin: 55px auto 0;

  padding: 25px 0 35px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid #dededb;
}

footer .brand {
  font-size: 15px;
}

footer .brand-mark {
  width: 25px;
  height: 25px;
  font-size: 13px;
}

footer p {
  margin: 0;

  color: #888;

  font-size: 10px;
}

/* TABLET */

@media (min-width: 700px) {
  .navbar {
    padding: 0 35px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .nav-links a {
    color: #555;

    font-size: 11px;
    font-weight: 600;
  }

  .hero {
    margin-top: 28px;

    grid-template-columns: 0.85fr 1.15fr;

    align-items: stretch;
  }

  .hero-content {
    padding: 55px 15px 40px 0;
  }

  .hero-card {
    min-height: 560px;
  }

  .hero-card > img {
    height: 470px;
  }

  .product-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 17px;
  }

  .product-image {
    height: 270px;
  }

  .business-banner {
    flex-direction: row;

    align-items: flex-end;
    justify-content: space-between;

    padding: 45px;
  }
}

/* DESKTOP */

@media (min-width: 1000px) {
  .navbar {
    height: 74px;
    padding: 0 55px;
  }

  .brand {
    font-size: 20px;
  }

  .hero {
    width: min(1250px, calc(100% - 80px));

    grid-template-columns: 0.9fr 1.1fr;

    gap: 30px;
  }

  .hero-content {
    padding-top: 85px;
  }

  .hero h1 {
    font-size: 82px;
  }

  .hero-card {
    min-height: 610px;

    border-radius: 32px;
  }

  .hero-card > img {
    height: 520px;
  }

  .category-section,
  .products-section,
  .business-banner,
  .discover-section,
  footer {
    width: min(1250px, calc(100% - 80px));
  }

  .category-section,
  .products-section {
    margin-top: 85px;
  }

  .section-heading h2 {
    font-size: 34px;
  }

  .search-box {
    display: block;
  }

  .product-image {
    height: 320px;

    border-radius: 20px;
  }

  .product-details {
    padding-top: 13px;
  }

  .product-details h3 {
    font-size: 15px;
  }

  .product-bottom strong {
    font-size: 15px;
  }

  .product-bottom button {
    padding: 8px 12px;
    font-size: 9px;
  }

  .business-banner {
    margin-top: 110px;
  }

  .discover-section {
    padding: 45px;
  }
}

/* =========================================================
   AXIOM BUSINESS DASHBOARD
   ========================================================= */

.business-dashboard {
  min-height: 100vh;
  display: flex;
  background: #f6f6f4;
  color: #111;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.dashboard-sidebar {
  width: 260px;
  min-height: 100vh;
  background: #111;
  color: #fff;
  padding: 28px 20px;
  display: flex;
  flex-direction: column;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
}

.dashboard-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 46px;
}

.dashboard-brand .brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.35);
  border-radius: 50%;
  font-family: Georgia, serif;
}

.dashboard-label {
  font-size: 10px;
  letter-spacing: 2px;
  color: #888;
  margin: 0 0 14px;
}

.dashboard-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.dashboard-nav {
  width: 100%;
  border: 0;
  background: transparent;
  color: #aaa;
  padding: 13px 14px;
  border-radius: 10px;
  text-align: left;
  font-size: 14px;
  cursor: pointer;
  transition: .2s ease;
}

.dashboard-nav:hover {
  color: #fff;
  background: #1c1c1c;
}

.dashboard-nav.active {
  color: #111;
  background: #fff;
  font-weight: 700;
}

.sidebar-store {
  margin-top: auto;
  padding: 16px;
  border: 1px solid #2b2b2b;
  border-radius: 12px;
  background: #181818;
}

.sidebar-store span {
  display: block;
  font-size: 9px;
  letter-spacing: 2px;
  color: #777;
  margin-bottom: 8px;
}

.sidebar-store strong {
  display: block;
  font-size: 13px;
  margin-bottom: 5px;
}

.sidebar-store small {
  color: #777;
  font-size: 11px;
}

.dashboard-main {
  margin-left: 260px;
  width: calc(100% - 260px);
  min-height: 100vh;
  padding: 36px 42px 60px;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 34px;
}

.dashboard-header h1 {
  margin: 5px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 500;
  letter-spacing: -1px;
}

.eyebrow {
  margin: 0;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #777;
}

.dashboard-profile {
  border: 1px solid #ddd;
  background: #fff;
  padding: 9px 14px 9px 9px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 12px;
  cursor: pointer;
}

.dashboard-profile span {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #111;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
}

.welcome-card {
  background: #111;
  color: #fff;
  border-radius: 18px;
  padding: 34px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 22px;
}

.welcome-card .eyebrow {
  color: #999;
}

.welcome-card h2 {
  max-width: 620px;
  margin: 10px 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(27px, 4vw, 42px);
  font-weight: 500;
  line-height: 1.08;
}

.welcome-card p:not(.eyebrow) {
  max-width: 600px;
  color: #aaa;
  line-height: 1.7;
  margin-bottom: 0;
}

.dashboard-primary {
  border: 0;
  background: #fff;
  color: #111;
  padding: 13px 18px;
  border-radius: 8px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  transition: .2s ease;
}

.dashboard-primary:hover {
  transform: translateY(-2px);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.stat-card {
  background: #fff;
  border: 1px solid #e6e6e3;
  border-radius: 14px;
  padding: 22px;
}

.stat-card span {
  display: block;
  font-size: 9px;
  letter-spacing: 1.8px;
  color: #888;
}

.stat-card strong {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32px;
  font-weight: 500;
  margin: 12px 0 4px;
}

.stat-card small {
  color: #888;
  font-size: 11px;
}

.dashboard-panel,
.dashboard-placeholder {
  background: #fff;
  border: 1px solid #e6e6e3;
  border-radius: 16px;
  padding: 26px;
}

.panel-heading h2 {
  margin: 5px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26px;
  font-weight: 500;
}

.empty-dashboard {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon {
  width: 48px;
  height: 48px;
  border: 1px solid #ddd;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-family: Georgia, serif;
  margin-bottom: 15px;
}

.empty-dashboard h3 {
  margin: 0 0 7px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px;
  font-weight: 500;
}

.empty-dashboard p {
  color: #888;
  margin: 0 0 20px;
}

.dashboard-placeholder {
  min-height: 420px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.dashboard-placeholder h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 40px;
  font-weight: 500;
  margin: 8px 0;
}

.dashboard-placeholder p {
  color: #888;
}

/* MOBILE */

@media (max-width: 900px) {
  .dashboard-sidebar {
    width: 215px;
  }

  .dashboard-main {
    margin-left: 215px;
    width: calc(100% - 215px);
    padding: 28px 24px 50px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .welcome-card {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 650px) {
  .business-dashboard {
    display: block;
  }

  .dashboard-sidebar {
    position: static;
    width: 100%;
    min-height: auto;
    padding: 18px;
  }

  .dashboard-brand {
    margin-bottom: 20px;
  }

  .dashboard-sidebar nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .sidebar-store {
    display: none;
  }

  .dashboard-main {
    margin-left: 0;
    width: 100%;
    padding: 24px 16px 45px;
  }

  .dashboard-header {
    align-items: flex-start;
    gap: 15px;
  }

  .dashboard-profile {
    font-size: 0;
    padding: 6px;
  }

  .dashboard-profile span {
    font-size: 10px;
  }

  .welcome-card {
    padding: 24px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .stat-card {
    padding: 17px;
  }
}

/* AXIOM NAV ACTIONS */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
}

.nav-login,
.nav-sell {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-family: inherit;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.01em;
  transition: all 0.2s ease;
}

.nav-login {
  color: #111;
  padding: 10px 14px;
}

.nav-login:hover {
  opacity: 0.65;
}

.nav-sell {
  background: #111;
  color: #fff;
  padding: 11px 17px;
  border-radius: 999px;
}

.nav-sell:hover {
  background: #2b2b2b;
  transform: translateY(-1px);
}

.nav-actions .cart-button {
  margin-left: 2px;
}

@media (max-width: 760px) {
  .nav-actions {
    gap: 6px;
  }

  .nav-login {
    padding: 8px 9px;
  }

  .nav-sell {
    padding: 9px 11px;
    font-size: 12px;
  }

  .nav-actions .cart-button {
    padding: 9px 10px;
  }
}

/* =========================================
   AXIOM AUTHENTICATION
   ========================================= */

.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  background:
    radial-gradient(circle at top left, rgba(0, 0, 0, 0.045), transparent 35%),
    #f5f3ef;
}

.auth-card {
  width: min(100%, 480px);
  background: #fff;
  padding: 48px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.08);
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 54px;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.auth-brand .brand-mark {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  font-size: 15px;
}

.auth-card .eyebrow {
  margin-bottom: 12px;
}

.auth-card h1 {
  margin: 0;
  max-width: 400px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(38px, 6vw, 52px);
  line-height: 0.98;
  letter-spacing: -0.03em;
}

.auth-intro {
  margin: 18px 0 34px;
  color: #666;
  font-size: 14px;
  line-height: 1.7;
}

.auth-card form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.auth-card label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #222;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.auth-card input {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #ddd;
  background: #fafafa;
  padding: 15px 16px;
  outline: none;
  color: #111;
  font-family: inherit;
  font-size: 14px;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.auth-card input:focus {
  border-color: #111;
  background: #fff;
}

.auth-card input::placeholder {
  color: #aaa;
}

.auth-submit {
  width: 100%;
  margin-top: 4px;
  border: 0;
  cursor: pointer;
  padding: 16px 20px;
  font-size: 13px;
}

.auth-submit:disabled {
  opacity: 0.55;
  cursor: wait;
}

.auth-message {
  padding: 13px 14px;
  background: #f4eeee;
  border: 1px solid #e5d5d5;
  color: #8a2e2e;
  font-size: 13px;
  line-height: 1.5;
}

.auth-switch {
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid #eee;
  color: #777;
  font-size: 13px;
  line-height: 1.6;
}

.auth-switch button {
  border: 0;
  background: transparent;
  padding: 0;
  color: #111;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
}

@media (max-width: 600px) {
  .auth-page {
    padding: 18px;
    align-items: flex-start;
  }

  .auth-card {
    margin-top: 12px;
    padding: 32px 24px;
  }

  .auth-brand {
    margin-bottom: 42px;
  }

  .auth-card h1 {
    font-size: 42px;
  }
}

.product-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  overflow-y: auto;
}

.product-modal {
  position: relative;
  z-index: 10000;
  width: min(620px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  background: #ffffff;
  border-radius: 22px;
  padding: 28px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
}

.product-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.product-modal-header h2 {
  margin: 4px 0 0;
  font-size: 28px;
  line-height: 1.15;
}

.modal-close {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  background: #f3f3f3;
  color: #111;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
  flex-shrink: 0;
}

.modal-close:hover {
  background: #e8e8e8;
}

.product-modal form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.product-modal label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: #222;
}

.product-modal input,
.product-modal textarea,
.product-modal select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #d9d9d9;
  border-radius: 12px;
  padding: 13px 14px;
  font: inherit;
  color: #111;
  background: #fff;
  outline: none;
}

.product-modal textarea {
  resize: vertical;
  min-height: 100px;
}

.product-modal input:focus,
.product-modal textarea:focus,
.product-modal select:focus {
  border-color: #111;
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
}

.product-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.product-form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 8px;
}

.product-cancel-button {
  border: 1px solid #d8d8d8;
  background: #fff;
  color: #111;
  border-radius: 12px;
  padding: 13px 20px;
  font-weight: 600;
  cursor: pointer;
}

.product-cancel-button:hover {
  background: #f5f5f5;
}

.product-modal .dashboard-primary {
  border: 0;
  border-radius: 12px;
  padding: 13px 22px;
  cursor: pointer;
}

@media (max-width: 600px) {
  .product-modal-backdrop {
    align-items: flex-start;
    padding: 16px;
  }

  .product-modal {
    max-height: calc(100vh - 32px);
    padding: 22px;
    border-radius: 18px;
  }

  .product-form-grid {
    grid-template-columns: 1fr;
  }

  .product-form-actions {
    flex-direction: column-reverse;
  }

  .product-form-actions button {
    width: 100%;
  }
}

.product-modal select {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  padding-right: 46px;
  background-image: linear-gradient(45deg, transparent 50%, #111 50%),
    linear-gradient(135deg, #111 50%, transparent 50%);
  background-position:
    calc(100% - 20px) 50%,
    calc(100% - 14px) 50%;
  background-size:
    6px 6px,
    6px 6px;
  background-repeat: no-repeat;
}

.product-modal select:hover {
  border-color: #aaa;
}

.product-modal select:focus {
  border-color: #111;
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
}

.product-modal option {
  background: #fff;
  color: #111;
  padding: 12px;
}

.axiom-status-options {
  display: grid;
  gap: 10px;
}

.axiom-status-option {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid #dedede;
  border-radius: 13px;
  background: #fff;
  color: #222;
  font: inherit;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.axiom-status-option:hover {
  border-color: #aaa;
  background: #fafafa;
}

.axiom-status-option.selected {
  border-color: #111;
  background: #f7f7f7;
}

.axiom-status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #b8b8b8;
  flex-shrink: 0;
}

.axiom-status-option.selected .axiom-status-dot {
  background: #111;
  box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.08);
}

.axiom-status-check {
  margin-left: auto;
  font-size: 18px;
  font-weight: 700;
}


.product-image-upload {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.product-image-upload-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 14px;
  font-weight: 700;
}

.product-image-upload-heading small {
  color: #777;
  font-weight: 500;
}

.product-image-dropzone {
  position: relative;
  width: 100%;
  min-height: 170px;
  box-sizing: border-box;
  border: 2px dashed #cfcfcf;
  border-radius: 18px;
  background: #fafafa;
  display: flex !important;
  flex-direction: column !important;
  align-items: center;
  justify-content: center;
  gap: 8px !important;
  text-align: center;
  cursor: pointer;
  overflow: hidden;
}

.product-image-dropzone:hover {
  border-color: #111;
  background: #f5f5f5;
}

.product-image-dropzone input[type="file"] {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.product-image-dropzone strong {
  font-size: 15px;
  color: #111;
}

.product-image-dropzone small {
  color: #777;
  font-weight: 400;
}

.upload-icon {
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #111;
  color: #fff;
  font-size: 28px;
  line-height: 1;
}

.product-image-preview-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
  width: 100%;
}

.product-image-preview {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 14px;
  background: #eee;
}

.product-image-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-image-preview button {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.78);
  color: #fff;
  font-size: 18px;
  line-height: 28px;
  text-align: center;
  cursor: pointer;
}

@media (max-width: 600px) {
  .product-image-dropzone {
    min-height: 155px;
  }

  .product-image-preview-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.product-no-image {
  width: 100%;
  height: 100%;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #f3f3f3;
  color: #111;
}

.product-no-image span {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.product-no-image small {
  color: #777;
  font-size: 12px;
}


.product-back-button {
  border: 0;
  background: transparent;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  color: #111;
}

.product-detail-main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 70px 24px 100px;
}

.product-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
  gap: 70px;
  align-items: start;
}

.product-main-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 28px;
  overflow: hidden;
  background: #f3f3f3;
}

.product-main-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-detail-no-image {
  width: 100%;
  height: 100%;
  min-height: 420px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: #f1f1f1;
}

.product-detail-no-image span {
  font-size: 38px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.product-detail-no-image small {
  color: #777;
}

.product-thumbnails {
  display: flex;
  gap: 12px;
  margin-top: 14px;
  overflow-x: auto;
}

.product-thumbnail {
  flex: 0 0 82px;
  width: 82px;
  height: 82px;
  padding: 0;
  border: 2px solid transparent;
  border-radius: 14px;
  overflow: hidden;
  background: #f1f1f1;
  cursor: pointer;
}

.product-thumbnail.active {
  border-color: #111;
}

.product-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-detail-info {
  padding-top: 10px;
}

.product-detail-category {
  margin: 0 0 14px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 12px;
  font-weight: 800;
  color: #777;
}

.product-detail-info h1 {
  margin: 0;
  font-size: clamp(36px, 5vw, 62px);
  line-height: 0.98;
  letter-spacing: -0.04em;
}

.product-detail-store {
  margin: 22px 0 0;
  color: #666;
}

.product-detail-price {
  margin-top: 30px;
  font-size: 32px;
  font-weight: 800;
}

.product-stock {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  font-size: 14px;
  font-weight: 700;
}

.product-stock span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #111;
}

.product-stock.out-stock span {
  background: #aaa;
}

.product-description {
  margin-top: 38px;
  padding-top: 28px;
  border-top: 1px solid #e5e5e5;
}

.product-description h3 {
  margin: 0 0 10px;
  font-size: 15px;
}

.product-description p {
  margin: 0;
  color: #666;
  line-height: 1.7;
}

.product-purchase {
  display: flex;
  gap: 12px;
  margin-top: 38px;
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 14px;
  overflow: hidden;
}

.quantity-control button {
  width: 48px;
  height: 54px;
  border: 0;
  background: #fff;
  font-size: 22px;
  cursor: pointer;
}

.quantity-control button:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.quantity-control strong {
  min-width: 42px;
  text-align: center;
}

.product-add-cart {
  flex: 1;
  min-height: 54px;
  border: 0;
  border-radius: 14px;
  background: #111;
  color: #fff;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.product-detail-message {
  margin-top: 16px;
  padding: 14px 16px;
  border-radius: 12px;
  background: #f3f3f3;
  font-size: 14px;
  font-weight: 700;
}

.product-page-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  padding: 24px;
  text-align: center;
}

@media (max-width: 800px) {
  .product-detail-main {
    padding: 35px 18px 70px;
  }

  .product-detail-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .product-detail-info h1 {
    font-size: 42px;
  }

  .product-purchase {
    flex-direction: column;
  }

  .quantity-control {
    width: 100%;
    justify-content: space-between;
  }

  .quantity-control button {
    flex: 1;
  }

  .product-add-cart {
    width: 100%;
  }
}

