function App() {
  const path = window.location.pathname;

  const productMatch =
    path.match(
      /^\/product\/([^/]+)$/
    );

  if (productMatch) {
    return (
      <ProductDetails
        productId={productMatch[1]}
      />
    );
  }

  if (path === "/cart") {
    return <Cart />;
  }

  if (path === "/business") {
    return <BusinessDashboard />;
  }

  if (
    path === "/login" ||
    path === "/register"
  ) {
    return <AuthPage />;
  }

  return <Market />;
}

export default App;
